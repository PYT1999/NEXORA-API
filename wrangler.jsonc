{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexora-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "RESET_FROM_EMAIL": "NEXORA <noreply@mail.nexorasystems.ch>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexora-db",
      "database_id": "affbc5a7-3778-4e31-b06f-130a3e9f373a"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "REALMS",
        "class_name": "RealmRoom"
      }
    ]
  },

  "exports": {
    "RealmRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "bbbc1becca17494f890f9a145dde6632",
      "secret_name": "RESEND_API_KEY"
    },
    {
      "binding": "PASSWORD_RESET_SECRET",
      "store_id": "bbbc1becca17494f890f9a145dde6632",
      "secret_name": "PASSWORD_RESET_SECRET"
    }
  ]
}
